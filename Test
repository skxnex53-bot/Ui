		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.Text})

	local list = new("Frame", {Parent = f, ZIndex = 6, Position = UDim2.new(0,10,0,ROW),
		Size = UDim2.new(1,-20,0,0), BackgroundTransparency = 1, ClipsDescendants = true,
