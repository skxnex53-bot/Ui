		(self.Content.AbsolutePosition.X - self.Window.AbsolutePosition.X) + self.Content.AbsoluteSize.X / 2,
		(self.Content.AbsolutePosition.Y - self.Window.AbsolutePosition.Y) + self.Content.AbsoluteSize.Y / 2
