local LIQUID  = TweenInfo.new(0.75, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)

local NO_TWEEN = { NumberSequence = true, ColorSequence = true, NumberRange = true }

local function tw(obj, info, props)
	if not obj or not obj.Parent then return nil end
	local safe = {}
	for k, v in pairs(props) do
		if NO_TWEEN[typeof(v)] then
			pcall(function() obj[k] = v end)
		else
			safe[k] = v
		end
	end
	local ok, t = pcall(TweenService.Create, TweenService, obj, info, safe)
	if not ok or not t then return nil end
	t:Play()
	return t
end

local gradTask = {}
local function fadeGrad(grad, from, to, dur)
	local id = tick() + math.random()
	gradTask[grad] = id
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < dur do
			if gradTask[grad] ~= id or not grad.Parent then return end
			local a = (os.clock() - t0) / dur
			a = 1 - (1 - a) ^ 3
			grad.Transparency = NumberSequence.new(from + (to - from) * a)
			task.wait()
		end
		if gradTask[grad] == id and grad.Parent then
			grad.Transparency = NumberSequence.new(to)
		end
	end)
end

local function rnd(a, b) return a + math.random() * (b - a) end

local function new(class, props, kids)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do if k ~= "Parent" then o[k] = v end end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	if props and props.Parent then o.Parent = props.Parent end
	return o
end

local function corner(r) return new("UICorner", {CornerRadius = UDim.new(0, r)}) end
local function circle()  return new("UICorner", {CornerRadius = UDim.new(1, 0)}) end
local function stroke(c, t, tr)
	return new("UIStroke", {Color = c or Theme.Stroke, Thickness = t or 1,
		Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
end

local function applyGlass(frame, transparency, tint)
	frame.BackgroundColor3       = tint or Theme.Glass
	frame.BackgroundTransparency = transparency or 0.28

	new("UIGradient", {Parent = frame, Rotation = 90,
		Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(160, 170, 205)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB( 95, 100, 130)),
		}})

	local s = stroke(Color3.fromRGB(255, 255, 255), 1.3, 0.45)
	s.Parent = frame
	new("UIGradient", {Parent = s, Rotation = 90,
		Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.40, Color3.fromRGB(110, 120, 155)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(200, 210, 245)),
		}})

	local hl = new("Frame", {Parent = frame, BorderSizePixel = 0, ZIndex = frame.ZIndex + 1,
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.55,
		Position = UDim2.new(0, 8, 0, 2), Size = UDim2.new(1, -16, 0, 1)})
	new("UIGradient", {Parent = hl, Transparency = NumberSequence.new{
		NumberSequenceKeypoint.new(0.0, 1), NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1.0, 1)}})
	return s
end

local function sheen(frame, dur, z)
	local band = new("Frame", {Parent = frame, BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.86,
		AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 16, ZIndex = z or 8,
		Position = UDim2.new(-0.35, 0, 0.5, 0), Size = UDim2.new(0.22, 0, 2.2, 0)})
	new("UIGradient", {Parent = band, Transparency = NumberSequence.new{
		NumberSequenceKeypoint.new(0.0, 1), NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1.0, 1)}})
	tw(band, TweenInfo.new(dur or 0.9, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{Position = UDim2.new(1.35, 0, 0.5, 0)})
	Debris:AddItem(band, (dur or 0.9) + 0.2)
	return band
end

local function caustics(parent, count)
	for i = 1, (count or 4) do
		local sz  = math.random(120, 240)
		local col = ({Theme.Aqua, Theme.Violet, Theme.Rose})[math.random(1, 3)]
		local b = new("Frame", {Parent = parent, ZIndex = 0, BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = col,
			BackgroundTransparency = 0.9, Size = UDim2.fromOffset(sz, sz),
			Position = UDim2.fromScale(rnd(0.1, 0.9), rnd(0.1, 0.9))}, { circle() })
		new("UIGradient", {Parent = b, Transparency = NumberSequence.new{
			NumberSequenceKeypoint.new(0.0, 0.35), NumberSequenceKeypoint.new(1.0, 1)}})
		task.spawn(function()
			while b.Parent do
				local t = tw(b, TweenInfo.new(rnd(6, 11), Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut), {
					Position = UDim2.fromScale(rnd(0.05, 0.95), rnd(0.05, 0.95)),
					Size = UDim2.fromOffset(sz * rnd(0.7, 1.3), sz * rnd(0.7, 1.3))})
				if t then t.Completed:Wait() else break end
			end
		end)
	end
end

local function liquidRipple(parent, pos, color, maxSize)
	local r = new("Frame", {Parent = parent, ZIndex = 40, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = pos,
		BackgroundColor3 = color, BackgroundTransparency = 0.55,
		Size = UDim2.fromOffset(6, 6)}, { circle() })
	local rs = stroke(color, 2.4, 0.15); rs.Parent = r
	tw(r,  TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{Size = UDim2.fromOffset(maxSize or 110, maxSize or 110), BackgroundTransparency = 1})
	tw(rs, TweenInfo.new(0.6, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out),
		{Transparency = 1, Thickness = 0.2})
	Debris:AddItem(r, 0.8)
end

local function makeYinYang(parent, size, pos, spin, z)
	z = z or 5
	local h = new("Frame", {Parent = parent, Size = UDim2.fromOffset(size, size),
		Position = pos, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z,
		BackgroundColor3 = Theme.Yang, ClipsDescendants = true,
	}, { circle(), stroke(Color3.new(1,1,1), 1, 0.4) })
	local function part(p) p.ZIndex = z; return p end
	part(new("Frame", {Parent=h, Size=UDim2.fromScale(0.5,1), Position=UDim2.fromScale(0.5,0), BackgroundColor3=Theme.Yin, BorderSizePixel=0}))
	part(new("Frame", {Parent=h, Size=UDim2.fromScale(0.5,0.5), Position=UDim2.fromScale(0.5,0.25), AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=Theme.Yin, BorderSizePixel=0},{circle()}))
	part(new("Frame", {Parent=h, Size=UDim2.fromScale(0.5,0.5), Position=UDim2.fromScale(0.5,0.75), AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=Theme.Yang, BorderSizePixel=0},{circle()}))
	part(new("Frame", {Parent=h, Size=UDim2.fromScale(0.16,0.16), Position=UDim2.fromScale(0.5,0.25), AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=Theme.Yang, BorderSizePixel=0},{circle()})).ZIndex = z+1
	part(new("Frame", {Parent=h, Size=UDim2.fromScale(0.16,0.16), Position=UDim2.fromScale(0.5,0.75), AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=Theme.Yin, BorderSizePixel=0},{circle()})).ZIndex = z+1
	if spin then
		RunService.RenderStepped:Connect(function(dt)
			if h.Parent then h.Rotation = (h.Rotation + dt * 22) % 360 end
		end)
	end
	return h
end

local function card(parent, h)
	local f = new("Frame", {Parent = parent, ZIndex = 4, Size = UDim2.new(1,-6,0,h),
		ClipsDescendants = true}, { corner(12) })
	local cs = applyGlass(f, 0.42, Theme.Card)

	local wet = new("Frame", {Parent = f, ZIndex = 3, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5,0.5), Size = UDim2.fromOffset(150,150),
		BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5,0.5)}, { circle() })
	new("UIGradient", {Parent = wet, Transparency = NumberSequence.new{
		NumberSequenceKeypoint.new(0, 0.78), NumberSequenceKeypoint.new(1, 1)}})

	f.MouseMoved:Connect(function(x, y)
		local rel = Vector2.new(x, y) - f.AbsolutePosition
		wet.Position = UDim2.fromScale(rel.X / math.max(f.AbsoluteSize.X,1), rel.Y / math.max(f.AbsoluteSize.Y,1))
	end)
	f.MouseEnter:Connect(function()
		tw(f,  SMOOTH, {BackgroundColor3 = Theme.CardHov, BackgroundTransparency = 0.3})
		tw(cs, SMOOTH, {Transparency = 0.15, Thickness = 1.8})
		tw(wet, SMOOTH, {BackgroundTransparency = 0})
		sheen(f, 0.75, 9)
	end)
	f.MouseLeave:Connect(function()
		tw(f,  SMOOTH, {BackgroundColor3 = Theme.Card, BackgroundTransparency = 0.42})
		tw(cs, SMOOTH, {Transparency = 0.45, Thickness = 1.3})
		tw(wet, SMOOTH, {BackgroundTransparency = 1})
	end)
	return f, cs
end

