	head.MouseButton1Click:Connect(toggle)

	for idx, opt in ipairs(options) do
		local b = new("TextButton", {Parent = list, ZIndex = 6, Size = UDim2.new(1,0,0,28),
			Text = opt, LayoutOrder = idx, Font = Enum.Font.Gotham, TextSize = 11.5,
			TextColor3 = Theme.Sub, BackgroundColor3 = Theme.Panel,
			BackgroundTransparency = 0.5, AutoButtonColor = false,
			ClipsDescendants = true}, { corner(8), stroke(Color3.new(1,1,1), 1, 0.8) })
		local bs = new("UIScale", {Parent = b, Scale = 1})
		items[idx] = b

		b.MouseEnter:Connect(function()
			tw(b, SMOOTH, {BackgroundTransparency = 0.15, TextColor3 = Theme.Text})
			tw(bs, SMOOTH, {Scale = 1.04})
			sheen(b, 0.55, 9)
		end)
		b.MouseLeave:Connect(function()
			tw(b, SMOOTH, {BackgroundTransparency = 0.5, TextColor3 = Theme.Sub})
			tw(bs, SMOOTH, {Scale = 1})
		end)
		b.MouseButton1Click:Connect(function()
			selected.Text = opt
			liquidRipple(lib.FxLayer, lib:ToLayer(b), Theme.Violet, 100)
			tw(selected, POP, {TextColor3 = Theme.Aqua})
			task.delay(0.5, function() tw(selected, SMOOTH, {TextColor3 = Theme.Sub}) end)
			if cb then task.spawn(cb, opt) end
			if open then toggle() end
		end)
	end
end

function Library.Components:AddTextBox(text, placeholder, cb)
	local parent, lib = self.Page, self.Lib
	local f = card(parent, 46); label(f, text)

	local box = new("TextBox", {Parent = f, ZIndex = 6, AnchorPoint = Vector2.new(1,0.5),
		Position = UDim2.new(1,-14,0.5,0), Size = UDim2.fromOffset(134,29),
		BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.35, Text = "",
		PlaceholderText = placeholder, PlaceholderColor3 = Theme.Off,
		TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 11.5,
		ClearTextOnFocus = false, ClipsDescendants = true,
		TextTruncate = Enum.TextTruncate.AtEnd}, { corner(9) })
	new("UIPadding", {Parent = box, PaddingLeft = UDim.new(0,10), PaddingRight = UDim.new(0,10)})

	local st = stroke(Color3.new(1,1,1), 1.2, 0.55); st.Parent = box
	local glow = new("Frame", {Parent = f, ZIndex = 5, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-14,0.5,0),
		Size = UDim2.fromOffset(134,29)}, { corner(9) })
	local gs = stroke(Theme.Aqua, 0, 1); gs.Parent = glow

	box.Focused:Connect(function()
		tw(st,  SMOOTH, {Color = Theme.Aqua, Thickness = 2, Transparency = 0})
		tw(gs,  SMOOTH, {Thickness = 4, Transparency = 0.6})
		tw(box, POP, {Size = UDim2.fromOffset(152,31), BackgroundTransparency = 0.15})
		tw(glow, POP, {Size = UDim2.fromOffset(152,31)})
		sheen(box, 0.7, 9)
	end)
	box.FocusLost:Connect(function(enter)
		tw(st,  SMOOTH, {Color = Color3.new(1,1,1), Thickness = 1.2, Transparency = 0.55})
		tw(gs,  SMOOTH, {Thickness = 0, Transparency = 1})
		tw(box, POP, {Size = UDim2.fromOffset(134,29), BackgroundTransparency = 0.35})
		tw(glow, POP, {Size = UDim2.fromOffset(134,29)})
		if enter then
			liquidRipple(lib.FxLayer, lib:ToLayer(box), Theme.Aqua, 110)
			lib:Burst(lib:ToLayer(box), Theme.Aqua, 11, 28)
			lib:Click(1.2)
			if cb then task.spawn(cb, box.Text) end
		end
	end)
end

return Library
