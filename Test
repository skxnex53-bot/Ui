local NO_TWEEN = { NumberSequence = true, ColorSequence = true, NumberRange = true }

local function tw(obj, info, props)
	if not obj or not obj.Parent then return nil end
	local safe = {}
	for k, v in pairs(props) do
		if NO_TWEEN[typeof(v)] then
			pcall(function() obj[k] = v end)
		else
			safe[k] = v
		end
	end
	local ok, t = pcall(TweenService.Create, TweenService, obj, info, safe)
	if not ok or not t then return nil end
	t:Play()
	return t
end

local gradTask = {}
local function fadeGrad(grad, from, to, dur)
	local id = tick() + math.random()
	gradTask[grad] = id
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < dur do
			if gradTask[grad] ~= id or not grad.Parent then return end
			local a = (os.clock() - t0) / dur
			a = 1 - (1 - a) ^ 3
			grad.Transparency = NumberSequence.new(from + (to - from) * a)
			task.wait()
		end
		if gradTask[grad] == id and grad.Parent then
			grad.Transparency = NumberSequence.new(to)
		end
	end)
end

local function rnd(a, b) return a + math.random() * (b - a) end

local function new(class, props, kids)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do if k ~= "Parent" then o[k] = v end end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	if props and props.Parent then o.Parent = props.Parent end
	return o
end

