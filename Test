			Position = centerPos, Size = UDim2.fromOffset(sz, sz),
			BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 98
		}, { circle() })

		tw(p, TweenInfo.new(rnd(0.55, 0.95), Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(
				centerPos.X.Offset + math.cos(ang) * dist,
				centerPos.Y.Offset + math.sin(ang) * dist
			),
			Size = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1
		})
		Debris:AddItem(p, 1.0)
	end

	local flash = new("Frame", {
		Parent = self.FxLayer, Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = primaryColor, BackgroundTransparency = 0.82,
				ZIndex = 95
	}, { corner(18) })
	new("UIGradient", {
		Parent = flash,
		Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0.0, primaryColor),
			ColorSequenceKeypoint.new(0.5, secondaryColor),
			ColorSequenceKeypoint.new(1.0, Theme.Yang)
		}
	})
	tw(flash, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1
	})
	Debris:AddItem(flash, 0.65)

	sheen(self.Window, 0.5, 90)
	task.delay(0.12, function() sheen(self.Window, 0.6, 90) end)

	local page = self.Pages[pageName]
	if page then
		local cardIndex = 0
		local slideDirection = (pageName == "Mine") and -45 or 45
		for _, child in ipairs(page:GetChildren()) do
			if child:IsA("Frame") then
				cardIndex = cardIndex + 1
				local idx = cardIndex
				local origY = child.Position.Y.Offset
				child.Position = UDim2.new(0, slideDirection, 0, origY)
				child.BackgroundTransparency = 0.95
				task.delay(idx * 0.04, function()
					tw(child, TweenInfo.new(0.48, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
						Position = UDim2.new(0, 0, 0, origY),
						BackgroundTransparency = 0.42
					})
					sheen(child, 0.5, 10)
				end)
			end
		end
	end
end

function Library:SwitchTab(name)
	if self.ActiveTab == name then return end
	local old = self.ActiveTab; self.ActiveTab = name

	if old then
		local p = self.Pages[old]
		tw(self.Buttons[old], SMOOTH, {BackgroundTransparency = 1, TextColor3 = Theme.Sub})
		local os = self.Buttons[old]:FindFirstChildOfClass("UIStroke")
		if os then tw(os, SMOOTH, {Transparency = 1}) end
		
		local exitX = (name == "Mine 1") and -24 or 24
		tw(p, TweenInfo.new(0.18), {Position = UDim2.new(0, exitX, 0, 62)})
		task.delay(0.18, function() if self.ActiveTab ~= old then p.Visible = false end end)
	end

	local p = self.Pages[name]
	local enterX = (name == "Mine 1") and 34 or -34
	p.Position = UDim2.new(0, enterX, 0, 62); p.Visible = true
	tw(p, QUINT, {Position = UDim2.new(0,12,0,62)})

	local b = self.Buttons[name]
	tw(b, SMOOTH, {BackgroundTransparency = 0.4, TextColor3 = Theme.Text})
	local bs = b:FindFirstChildOfClass("UIStroke")
	if bs then tw(bs, SMOOTH, {Transparency = 0.4}) end
	sheen(b, 0.7, 9)

	local bScale = b:FindFirstChildOfClass("UIScale")
	if bScale then
		tw(bScale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.92})
		task.delay(0.1, function()
			tw(bScale, SPRING, {Scale = 1})
		end)
	end

	local btnPos = self:ToLayer(b)
	local themeCol = (name == "Mine 1") and Theme.Aqua or Theme.Rose
	liquidRipple(self.FxLayer, btnPos, themeCol, 100)
	self:Burst(btnPos, themeCol, 12, 28)

	local targetY = b.AbsolutePosition.Y - self.Window.AbsolutePosition.Y + 9
	tw(self.TabGlow, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 3, 0, targetY),
		Size = UDim2.new(0, 4, 0, 26),
		BackgroundColor3 = themeCol
	})
	task.delay(0.18, function()
		tw(self.TabGlow, SPRING, {Size = UDim2.new(0, 3, 0, 18)})
	end)

	self.TitleLabel.Text = name
	self.TitleLabel.Position = UDim2.new(0,28,0,18)
	self.TitleLabel.TextTransparency = 1
	tw(self.TitleLabel, QUINT, {Position = UDim2.new(0,18,0,18), TextTransparency = 0})

	if old then self:Click(1.05) end

	if name == "Mine 1" then
		self:PlayPageEpicTransition("Mine 1", Theme.Aqua)
	elseif name == "Mine" then
		self:PlayPageEpicTransition("Mine", Theme.Rose)
	end
end

function Library:AddTab(name)
	self.TabOrder = self.TabOrder + 1
	local page = new("ScrollingFrame", {Parent = self.Content, ZIndex = 4,
		BackgroundTransparency = 1, Visible = false,
		Position = UDim2.new(0,12,0,62), Size = UDim2.new(1,-24,1,-76),
		ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Stroke,
		ScrollBarImageTransparency = 0.4, BorderSizePixel = 0,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, {
		new("UIListLayout", {Padding = UDim.new(0,10), SortOrder = Enum.SortOrder.LayoutOrder}),
		new("UIPadding", {PaddingTop = UDim.new(0,4), PaddingBottom = UDim.new(0,14)}),
	})

	local btn = new("TextButton", {Parent = self.TabHolder, ZIndex = 6, LayoutOrder = self.TabOrder,
		Size = UDim2.new(1,0,0,36), BackgroundColor3 = Theme.Card,
		BackgroundTransparency = 1, Text = name, Font = Enum.Font.GothamMedium,
		TextSize = 12.5, TextColor3 = Theme.Sub, AutoButtonColor = false,
		ClipsDescendants = true}, { corner(10), stroke(Color3.new(1,1,1), 1, 1) })

	new("UIScale", {Parent = btn, Scale = 1})

	self.Pages[name], self.Buttons[name] = page, btn

	btn.MouseEnter:Connect(function()
		if self.ActiveTab ~= name then
			tw(btn, SMOOTH, {BackgroundTransparency = 0.7, TextColor3 = Theme.Text})
			sheen(btn, 0.55, 9)
		end
	end)
	btn.MouseLeave:Connect(function()
		if self.ActiveTab ~= name then tw(btn, SMOOTH, {BackgroundTransparency = 1, TextColor3 = Theme.Sub}) end
	end)
	btn.MouseButton1Click:Connect(function() self:SwitchTab(name) end)

	local TabObj = {Page = page, Lib = self}
	setmetatable(TabObj, {__index = Library.Components})
	return TabObj
end

