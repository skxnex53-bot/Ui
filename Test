		Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
end

local function applyGlass(frame, transparency, tint)
	frame.BackgroundColor3       = tint or Theme.Glass
	frame.BackgroundTransparency = transparency or 0.28

	new("UIGradient", {Parent = frame, Rotation = 90,
		Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(160, 170, 205)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB( 95, 100, 130)),
		}})

	local s = stroke(Color3.fromRGB(255, 255, 255), 1.3, 0.45)
	s.Parent = frame
	new("UIGradient", {Parent = s, Rotation = 90,
		Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.40, Color3.fromRGB(110, 120, 155)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(200, 210, 245)),
		}})

	local hl = new("Frame", {Parent = frame, BorderSizePixel = 0, ZIndex = frame.ZIndex + 1,
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.55,
		Position = UDim2.new(0, 8, 0, 2), Size = UDim2.new(1, -16, 0, 1)})
	new("UIGradient", {Parent = hl, Transparency = NumberSequence.new{
		NumberSequenceKeypoint.new(0.0, 1), NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1.0, 1)}})
	return s
end

