function Library.Components:AddToggle(text, default, cb)
	local parent, lib = self.Page, self.Lib
	local f   = card(parent, 50)
	local lbl = label(f, text)
	local state = default and true or false

	local ON_L, OFF_L, KNOB = UDim2.new(1,-23,0.5,0), UDim2.new(0,3,0.5,0), 19

	local track = new("TextButton", {Parent = f, Text = "", AutoButtonColor = false, ZIndex = 6,
		AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-14,0.5,0),
		Size = UDim2.fromOffset(52,26), ClipsDescendants = true,
		BackgroundColor3 = state and Theme.Yang or Theme.Off,
		BackgroundTransparency = state and 0.05 or 0.35}, { circle() })

	local tScale  = new("UIScale", {Parent = track, Scale = 1})
	local tStroke = stroke(Color3.new(1,1,1), 1.4, 0.4); tStroke.Parent = track

	local grad = new("UIGradient", {Parent = track, Rotation = 0,
		Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,255,255)),
			ColorSequenceKeypoint.new(0.35, Theme.Aqua),
			ColorSequenceKeypoint.new(0.65, Theme.Violet),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,255,255))},
		Transparency = NumberSequence.new(state and 0 or 1)})

	local halo = new("Frame", {Parent = f, ZIndex = 5, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-14,0.5,0),
		Size = UDim2.fromOffset(52,26)}, { circle() })
	local haloStroke = stroke(Theme.Aqua, 0, 1); haloStroke.Parent = halo

	local ripple = new("Frame", {Parent = track, ZIndex = 7, AnchorPoint = Vector2.new(0.5,0.5),
		Size = UDim2.fromOffset(0,0), BackgroundColor3 = Theme.Yang,
		BackgroundTransparency = 1, BorderSizePixel = 0}, { circle() })

	local knob = new("Frame", {Parent = track, ZIndex = 8, Size = UDim2.fromOffset(KNOB,KNOB),
		AnchorPoint = Vector2.new(0,0.5), Position = state and ON_L or OFF_L,
		BackgroundColor3 = Theme.Yang, BorderSizePixel = 0}, { circle() })
	stroke(Color3.new(1,1,1), 1, 0.35).Parent = knob

	local knobDot = new("Frame", {Parent = knob, ZIndex = 9, Size = UDim2.fromOffset(7,7),
		AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.fromScale(0.5,0.5),
		BackgroundColor3 = state and Theme.Aqua or Theme.Off,
		BorderSizePixel = 0}, { circle() })

	local micro = new("TextLabel", {Parent = f, ZIndex = 6, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-74,0.5,0),
		Size = UDim2.fromOffset(34,16), Text = state and "ON" or "OFF",
		Font = Enum.Font.GothamBold, TextSize = 10,
		TextColor3 = state and Theme.Aqua or Theme.Off,
		TextTransparency = state and 0 or 0.35,
		TextXAlignment = Enum.TextXAlignment.Right})

	local shimmer = TweenService:Create(grad,
		TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{Offset = Vector2.new(0.45, 0)})
	local breathe = TweenService:Create(haloStroke,
		TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{Transparency = 0.45, Thickness = 3})

	local function idle(on)
		if on then
			fadeGrad(grad, 1, 0, 0.3)
			shimmer:Play()
			haloStroke.Thickness, haloStroke.Transparency = 1, 0.8
			breathe:Play()
		else
			fadeGrad(grad, 0, 1, 0.3)
			shimmer:Cancel(); grad.Offset = Vector2.new(0,0)
			breathe:Cancel()
			tw(haloStroke, SMOOTH, {Transparency = 1, Thickness = 0})
		end
	end

	local function droplets(fromPos, toPos)
		for i = 1, 4 do
			local d = new("Frame", {Parent = track, ZIndex = 7,
				Size = UDim2.fromOffset(KNOB, KNOB), AnchorPoint = Vector2.new(0,0.5),
				Position = fromPos, BorderSizePixel = 0,
				BackgroundColor3 = state and Theme.Aqua or Theme.Yang,
				BackgroundTransparency = 0.35 + i * 0.13}, { circle() })
			task.delay(i * 0.032, function()
				tw(d, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{Position = toPos, BackgroundTransparency = 1,
					 Size = UDim2.fromOffset(KNOB - i*3, KNOB - i*2)})
			end)
			Debris:AddItem(d, 0.7)
		end
	end

	local busy = false
	local function apply(anim)
		local target = state and ON_L or OFF_L

		if not anim then
			track.BackgroundColor3 = state and Theme.Yang or Theme.Off
			track.BackgroundTransparency = state and 0.05 or 0.35
			knob.Position = target
			grad.Transparency = NumberSequence.new(state and 0 or 1)
			knobDot.BackgroundColor3 = state and Theme.Aqua or Theme.Off
			idle(state); return
		end

		droplets(state and OFF_L or ON_L, target)

		tw(track, SMOOTH, {BackgroundColor3 = state and Theme.Yang or Theme.Off,
			BackgroundTransparency = state and 0.05 or 0.35})
		tw(tScale, TweenInfo.new(0.09), {Scale = 0.88})
		task.delay(0.09, function() tw(tScale, SPRING, {Scale = 1}) end)

		tw(knob, TweenInfo.new(0.1), {Size = UDim2.fromOffset(KNOB + 9, KNOB - 3)})
		tw(knob, SPRING, {Position = target})
		task.delay(0.17, function() tw(knob, LIQUID, {Size = UDim2.fromOffset(KNOB, KNOB)}) end)

		tw(knobDot, SMOOTH, {BackgroundColor3 = state and Theme.Aqua or Theme.Off})

		ripple.Position = UDim2.new(state and 1 or 0, state and -13 or 13, 0.5, 0)
		ripple.Size = UDim2.fromOffset(0,0)
		ripple.BackgroundColor3 = state and Theme.Aqua or Theme.Yang
		ripple.BackgroundTransparency = 0.5
		tw(ripple, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{Size = UDim2.fromOffset(130,130), BackgroundTransparency = 1})

		sheen(f, 0.6, 12)

		local c   = lib:ToLayer(track)
		local col = state and Theme.Aqua or Color3.fromRGB(160,165,185)
		liquidRipple(lib.FxLayer, c, col, state and 130 or 90)
		lib:Shockwave(c, col, state and 92 or 64, state and 3 or 1.8)
		task.delay(0.07, function() lib:Shockwave(c, Theme.Violet, state and 64 or 46, 1.4) end)
		lib:Burst(c, col, state and 18 or 10, state and 44 or 26)

		micro.Position = UDim2.new(1,-74,0.5, state and 9 or -9)
		micro.Text = state and "ON" or "OFF"
		micro.TextTransparency = 1
		tw(micro, POP, {Position = UDim2.new(1,-74,0.5,0),
			TextTransparency = state and 0 or 0.35,
			TextColor3 = state and Theme.Aqua or Theme.Off})

		tw(lbl, SMOOTH, {TextColor3 = state and Theme.Aqua or Theme.Text})
		idle(state)
		lib:Click(state and 1.15 or 0.85)
	end

	track.MouseEnter:Connect(function()
		tw(tStroke, SMOOTH, {Transparency = 0.05, Thickness = 2.2})
		tw(tScale,  SMOOTH, {Scale = 1.07})
	end)
	track.MouseLeave:Connect(function()
		tw(tStroke, SMOOTH, {Transparency = 0.4, Thickness = 1.4})
		tw(tScale,  SMOOTH, {Scale = 1})
	end)
	track.MouseButton1Click:Connect(function()
		if busy then return end
		busy = true
		state = not state
		apply(true)
		if cb then task.spawn(cb, state) end
		task.delay(0.18, function() busy = false end)
	end)

	apply(false)
end

function Library.Components:AddSlider(text, min, max, default, cb)
	local parent, lib = self.Page, self.Lib
	local f = card(parent, 60); label(f, text)
	local value = math.clamp(default, min, max)

	local vBox = new("TextLabel", {Parent = f, ZIndex = 6, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-14,0,0),
		Size = UDim2.fromOffset(58,42), Text = tostring(value),
		Font = Enum.Font.GothamBold, TextSize = 12.5, TextColor3 = Theme.Sub,
		TextXAlignment = Enum.TextXAlignment.Right})

	local bar = new("Frame", {Parent = f, ZIndex = 6, Position = UDim2.new(0,14,0,40),
		Size = UDim2.new(1,-28,0,7), BackgroundColor3 = Theme.Off,
		BackgroundTransparency = 0.35, BorderSizePixel = 0,
		ClipsDescendants = true}, { circle(), stroke(Color3.new(1,1,1), 1, 0.65) })

	local fill = new("Frame", {Parent = bar, ZIndex = 6, BorderSizePixel = 0,
		Size = UDim2.fromScale((value-min)/(max-min),1), BackgroundColor3 = Color3.new(1,1,1),
		ClipsDescendants = true}, { circle() })
	local fillGrad = new("UIGradient", {Parent = fill, Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,255,255)),
		ColorSequenceKeypoint.new(0.40, Theme.Aqua),
		ColorSequenceKeypoint.new(0.72, Theme.Violet),
		ColorSequenceKeypoint.new(1.00, Theme.Rose)}})

	TweenService:Create(fillGrad,
		TweenInfo.new(2.6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true),
		{Offset = Vector2.new(0.35, 0)}):Play()

	task.spawn(function()
		while fill.Parent do
			task.wait(rnd(0.35, 0.9))
			if fill.AbsoluteSize.X > 12 and lib.Window.Visible then
				local b = new("Frame", {Parent = fill, ZIndex = 7, BorderSizePixel = 0,
					AnchorPoint = Vector2.new(0.5,0.5), BackgroundColor3 = Color3.new(1,1,1),
					BackgroundTransparency = 0.35,
					Size = UDim2.fromOffset(math.random(2,4), math.random(2,4)),
					Position = UDim2.fromScale(rnd(0.05,0.95), 1.2)}, { circle() })
				tw(b, TweenInfo.new(rnd(0.8,1.4), Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
					{Position = UDim2.fromScale(rnd(0.05,0.95), -0.3), BackgroundTransparency = 1})
				Debris:AddItem(b, 1.6)
			end
		end
	end)

	local knob = new("Frame", {Parent = bar, Size = UDim2.fromOffset(15,15), ZIndex = 9,
		AnchorPoint = Vector2.new(0.5,0.5), BorderSizePixel = 0,
		Position = UDim2.fromScale((value-min)/(max-min),0.5),
		BackgroundColor3 = Theme.Yang}, { circle(), stroke(Color3.new(1,1,1), 1.5, 0.2) })

	local hit = new("TextButton", {Parent = bar, Text = "", BackgroundTransparency = 1,
		Size = UDim2.new(1,0,0,30), Position = UDim2.new(0,0,0.5,0),
		AnchorPoint = Vector2.new(0,0.5), ZIndex = 10, AutoButtonColor = false})

	local dragging, moveInput = false, nil
	local function set(px)
		local a = math.clamp((px - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X,1), 0, 1)
		local nv = math.floor(min + (max-min)*a + 0.5)
		if nv ~= value then lib:Click(0.9 + a*0.4) end
		value = nv
		local p = (value-min)/(max-min)
		tw(fill, TweenInfo.new(0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{Size = UDim2.fromScale(p,1)})
		tw(knob, TweenInfo.new(0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{Position = UDim2.fromScale(p,0.5)})
		vBox.Text = tostring(value)
		if cb then task.spawn(cb, value) end
	end

	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tw(knob, POP, {Size = UDim2.fromOffset(24,24)})
			tw(bar,  SMOOTH, {Size = UDim2.new(1,-28,0,10)})
			tw(vBox, SMOOTH, {TextColor3 = Theme.Aqua})
			set(i.Position.X)
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					dragging = false
					tw(knob, LIQUID, {Size = UDim2.fromOffset(15,15)})
					tw(bar,  SMOOTH, {Size = UDim2.new(1,-28,0,7)})
					tw(vBox, SMOOTH, {TextColor3 = Theme.Sub})
					liquidRipple(lib.FxLayer, lib:ToLayer(knob), Theme.Aqua, 70)
					lib:Burst(lib:ToLayer(knob), Theme.Aqua, 9, 24)
				end
			end)
		end
	end)
	hit.InputChanged:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch then moveInput = i end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i == moveInput or i.UserInputType == Enum.UserInputType.MouseMovement) then
			set(i.Position.X)
		end
	end)
end

function Library.Components:AddDropdown(text, options, cb)
