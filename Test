		ClipsDescendants = true}, { corner(12) })
	local cs = applyGlass(f, 0.42, Theme.Card)

	local wet = new("Frame", {Parent = f, ZIndex = 3, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5,0.5), Size = UDim2.fromOffset(150,150),
		BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5,0.5)}, { circle() })
	new("UIGradient", {Parent = wet, Transparency = NumberSequence.new{
		NumberSequenceKeypoint.new(0, 0.78), NumberSequenceKeypoint.new(1, 1)}})

	f.MouseMoved:Connect(function(x, y)
		local rel = Vector2.new(x, y) - f.AbsolutePosition
		wet.Position = UDim2.fromScale(rel.X / math.max(f.AbsoluteSize.X,1),
		                               rel.Y / math.max(f.AbsoluteSize.Y,1))
