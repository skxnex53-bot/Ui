function Library.CreateWindow(config)
	config = config or {}
	local title = config.Title or "YIN · YANG"
	local soundOn = config.Sound ~= false

	local gui = new("ScreenGui", {
		Name = "YinYangGlassUI", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})

	local blur
	pcall(function()
		blur = new("BlurEffect", {Name = "YYBlur", Size = 0, Parent = Lighting})
	end)

	local window = new("Frame", {
		Name = "Window", Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(BASE_W, BASE_H),
		ClipsDescendants = true, Visible = false,
	}, { corner(18) })
	local winStroke = applyGlass(window, 0.14)
	local uiScale   = new("UIScale", {Parent = window, Scale = 0})

	local glassBed = new("Frame", {Parent = window, ZIndex = 0, BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1), ClipsDescendants = true}, { corner(18) })
	caustics(glassBed, 5)

	local fxLayer = new("Frame", {Parent = window, BackgroundTransparency = 1, Active = false,
		Size = UDim2.fromScale(1,1), ZIndex = 90, ClipsDescendants = true})

	local function toLayer(obj)
		local s = math.max(uiScale.Scale, 0.001)
		local c = obj.AbsolutePosition + obj.AbsoluteSize / 2
		local o = (c - window.AbsolutePosition) / s
		return UDim2.fromOffset(math.floor(o.X), math.floor(o.Y))
	end

	local function burst(center, color, count, power)
		count, power = count or 14, power or 34
		for i = 1, count do
			local ang  = math.rad((360 / count) * i + rnd(-16, 16))
			local dist = rnd(power * 0.55, power)
			local sz   = math.random(3, 7)
			local p = new("Frame", {Parent = fxLayer, AnchorPoint = Vector2.new(0.5,0.5),
				Position = center, Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = color,
				BorderSizePixel = 0, ZIndex = 96}, { circle() })
			tw(p, TweenInfo.new(rnd(0.45, 0.75), Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Position = UDim2.fromOffset(center.X.Offset + math.cos(ang) * dist, center.Y.Offset + math.sin(ang) * dist),
				Size = UDim2.fromOffset(0,0), BackgroundTransparency = 1})
			Debris:AddItem(p, 0.9)
		end
	end

	local function shockwave(center, color, maxSize, thick)
		local ring = new("Frame", {Parent = fxLayer, AnchorPoint = Vector2.new(0.5,0.5),
			Position = center, Size = UDim2.fromOffset(14,14), BackgroundTransparency = 1, ZIndex = 94}, { circle() })
		local rs = stroke(color, thick or 2.5, 0.1); rs.Parent = ring
		tw(ring, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(maxSize or 78, maxSize or 78)})
		tw(rs, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1, Thickness = 0.2})
		Debris:AddItem(ring, 0.8)
	end

	local function click(pitch)
		if not soundOn then return end
		pcall(function()
			local s = Instance.new("Sound")
			s.SoundId = "rbxassetid://6042053626"
			s.Volume, s.PlaybackSpeed = 0.35, pitch or 1
			s.Parent = gui; s:Play(); Debris:AddItem(s, 2)
		end)
	end

	-- Sidebar & Navigation
	local sidebar = new("Frame", {Parent = window, ZIndex = 2, Size = UDim2.new(0, 150, 1, 0), ClipsDescendants = true}, { corner(18) })
	applyGlass(sidebar, 0.55, Theme.Panel)

	local logo = makeYinYang(sidebar, 52, UDim2.new(0.5, 0, 0, 50), true, 6)
	new("TextLabel", {Parent = sidebar, ZIndex = 6, BackgroundTransparency = 1, Text = title,
		Position = UDim2.new(0,0,0,82), Size = UDim2.new(1,0,0,18),
		Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Text})
	new("TextLabel", {Parent = sidebar, ZIndex = 6, BackgroundTransparency = 1, Text = "liquid glass",
		Position = UDim2.new(0,0,0,99), Size = UDim2.new(1,0,0,14),
		Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = Theme.Sub})

	local tabHolder = new("Frame", {Parent = sidebar, ZIndex = 6, BackgroundTransparency = 1,
		Position = UDim2.new(0,10,0,128), Size = UDim2.new(1,-22,1,-142),
	}, { new("UIListLayout", {Padding = UDim.new(0,8), SortOrder = Enum.SortOrder.LayoutOrder}) })

	local tabGlow = new("Frame", {Parent = sidebar, ZIndex = 8, Size = UDim2.new(0,3,0,18),
		Position = UDim2.new(0,3,0,137), BackgroundColor3 = Theme.Aqua, BorderSizePixel = 0}, { circle(), stroke(Theme.Aqua, 3, 0.6) })

	local content = new("Frame", {Parent = window, ZIndex = 3, BackgroundTransparency = 1,
		Position = UDim2.new(0,150,0,0), Size = UDim2.new(1,-150,1,0), ClipsDescendants = true})

	local titleLabel = new("TextLabel", {Parent = content, ZIndex = 4, BackgroundTransparency = 1,
		Position = UDim2.new(0,18,0,18), Size = UDim2.new(1,-90,0,22), Text = "",
		Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left})

	-- Drag & Close
	local dragBar = new("TextButton", {Parent = window, Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1,0,0,44), ZIndex = 50})
	local closeBtn = new("TextButton", {Parent = window, Text = "✕", AutoButtonColor = false, ZIndex = 60, AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-14,0,29), Size = UDim2.fromOffset(26,26), BackgroundColor3 = Theme.Card, BackgroundTransparency = 0.35, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Sub}, { circle(), stroke(Color3.new(1,1,1), 1, 0.55) })

	local function makeDraggable(frame, handle)
		local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
		handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging, dragStart, startPos = true, input.Position, frame.Position
				input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
			end
		end)
		handle.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and input == dragInput then
				local d = input.Position - dragStart
				local vp = workspace.CurrentCamera.ViewportSize
				local hw, hh = frame.AbsoluteSize.X / 2, frame.AbsoluteSize.Y / 2
				local x = math.clamp(startPos.X.Offset + d.X, -vp.X/2 + hw, vp.X/2 - hw)
				local y = math.clamp(startPos.Y.Offset + d.Y, -vp.Y/2 + hh, vp.Y/2 - hh)
				frame.Position = UDim2.new(0.5, x, 0.5, y)
			end
		end)
	end
	makeDraggable(window, dragBar)

	local pages, buttons, activeTab = {}, {}, nil
	local tabOrder = 0

	local function playPageEpicTransition(pageName, accentColor)
		local centerPos = UDim2.fromOffset(
			(content.AbsolutePosition.X - window.AbsolutePosition.X) + content.AbsoluteSize.X / 2,
			(content.AbsolutePosition.Y - window.AbsolutePosition.Y) + content.AbsoluteSize.Y / 2
		)

		click(1.35)
		task.delay(0.08, function() click(1.75) end)
		task.delay(0.16, function() click(2.15) end)

		local primaryColor = accentColor or Theme.Aqua
		local secondaryColor = (primaryColor == Theme.Aqua) and Theme.Violet or Theme.Rose

		shockwave(centerPos, primaryColor, 260, 4)
		task.delay(0.06, function() shockwave(centerPos, secondaryColor, 340, 3) end)

		for i = 1, 24 do
			local ang  = math.rad((360 / 24) * i + rnd(-15, 15))
			local dist = rnd(90, 220)
			local sz   = math.random(4, 9)
			local col  = ({primaryColor, secondaryColor, Theme.Yang})[math.random(1, 3)]
			local p = new("Frame", {Parent = fxLayer, AnchorPoint = Vector2.new(0.5, 0.5), Position = centerPos, Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 98}, { circle() })
			tw(p, TweenInfo.new(rnd(0.55, 0.95), Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Position = UDim2.fromOffset(centerPos.X.Offset + math.cos(ang) * dist, centerPos.Y.Offset + math.sin(ang) * dist),
				Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1
			})
			Debris:AddItem(p, 1.0)
		end

		sheen(window, 0.5, 90)

		local page = pages[pageName]
		if page then
			local cardIndex = 0
			local slideDirection = (pageName:find("1") or pageName:lower():find("alt")) and 45 or -45
			for _, child in ipairs(page:GetChildren()) do
				if child:IsA("Frame") then
					cardIndex = cardIndex + 1
					local origY = child.Position.Y.Offset
					child.Position = UDim2.new(0, slideDirection, 0, origY)
					child.BackgroundTransparency = 0.95
					task.delay(cardIndex * 0.04, function()
						tw(child, TweenInfo.new(0.48, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
							Position = UDim2.new(0, 0, 0, origY), BackgroundTransparency = 0.42
						})
						sheen(child, 0.5, 10)
					end)
				end
			end
		end
	end

	local function switchTab(name)
		if activeTab == name then return end
		local old = activeTab; activeTab = name

		if old then
			local p = pages[old]
			tw(buttons[old], SMOOTH, {BackgroundTransparency = 1, TextColor3 = Theme.Sub})
			local os = buttons[old]:FindFirstChildOfClass("UIStroke")
			if os then tw(os, SMOOTH, {Transparency = 1}) end

			local exitX = (name:find("1") or name:lower():find("alt")) and -24 or 24
			tw(p, TweenInfo.new(0.18), {Position = UDim2.new(0, exitX, 0, 62)})
			task.delay(0.18, function() if activeTab ~= old then p.Visible = false end end)
		end

		local p = pages[name]
		local enterX = (name:find("1") or name:lower():find("alt")) and 34 or -34
		p.Position = UDim2.new(0, enterX, 0, 62); p.Visible = true
		tw(p, QUINT, {Position = UDim2.new(0,12,0,62)})

		local b = buttons[name]
		tw(b, SMOOTH, {BackgroundTransparency = 0.4, TextColor3 = Theme.Text})
		local bs = b:FindFirstChildOfClass("UIStroke")
		if bs then tw(bs, SMOOTH, {Transparency = 0.4}) end
		sheen(b, 0.7, 9)

        	-- Capsule Animation
		local bScale = b:FindFirstChildOfClass("UIScale")
		if bScale then
			tw(bScale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.92})
			task.delay(0.1, function() tw(bScale, SPRING, {Scale = 1}) end)
		end

		local themeCol = (name:find("1") or name:lower():find("alt")) and Theme.Aqua or Theme.Rose
		local btnPos = toLayer(b)
		liquidRipple(fxLayer, btnPos, themeCol, 100)
		burst(btnPos, themeCol, 12, 28)

		-- Capsule Glow Spring
		local targetY = b.AbsolutePosition.Y - window.AbsolutePosition.Y + 9
		tw(tabGlow, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0, 3, 0, targetY), Size = UDim2.new(0, 4, 0, 26), BackgroundColor3 = themeCol
		})
		task.delay(0.18, function() tw(tabGlow, SPRING, {Size = UDim2.new(0, 3, 0, 18)}) end)

		titleLabel.Text = name
		titleLabel.Position = UDim2.new(0,28,0,18)
		titleLabel.TextTransparency = 1
		tw(titleLabel, QUINT, {Position = UDim2.new(0,18,0,18), TextTransparency = 0})

		if old then click(1.05) end
		playPageEpicTransition(name, themeCol)
	end

	-- Window API Output
	local WindowAPI = {}

	function WindowAPI:CreateTab(name)
		tabOrder = tabOrder + 1
		local page = new("ScrollingFrame", {Parent = content, ZIndex = 4, BackgroundTransparency = 1, Visible = false, Position = UDim2.new(0,12,0,62), Size = UDim2.new(1,-24,1,-76), ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Stroke, ScrollBarImageTransparency = 0.4, BorderSizePixel = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y}, {
			new("UIListLayout", {Padding = UDim.new(0,10), SortOrder = Enum.SortOrder.LayoutOrder}),
			new("UIPadding", {PaddingTop = UDim.new(0,4), PaddingBottom = UDim.new(0,14)}),
		})

		local btn = new("TextButton", {Parent = tabHolder, ZIndex = 6, LayoutOrder = tabOrder, Size = UDim2.new(1,0,0,36), BackgroundColor3 = Theme.Card, BackgroundTransparency = 1, Text = name, Font = Enum.Font.GothamMedium, TextSize = 12.5, TextColor3 = Theme.Sub, AutoButtonColor = false, ClipsDescendants = true}, { corner(10), stroke(Color3.new(1,1,1), 1, 1) })
		new("UIScale", {Parent = btn, Scale = 1})

		pages[name], buttons[name] = page, btn

		btn.MouseEnter:Connect(function()
			if activeTab ~= name then tw(btn, SMOOTH, {BackgroundTransparency = 0.7, TextColor3 = Theme.Text}); sheen(btn, 0.55, 9) end
		end)
		btn.MouseLeave:Connect(function()
			if activeTab ~= name then tw(btn, SMOOTH, {BackgroundTransparency = 1, TextColor3 = Theme.Sub}) end
		end)
		btn.MouseButton1Click:Connect(function() switchTab(name) end)

		if activeTab == nil then task.defer(function() switchTab(name) end) end

		local TabAPI = {}

		function TabAPI:AddToggle(text, default, cb)
			local f   = card(page, 50)
			local lbl = label(f, text)
			local state = default and true or false
			local ON_L, OFF_L, KNOB = UDim2.new(1,-23,0.5,0), UDim2.new(0,3,0.5,0), 19

			local track = new("TextButton", {Parent = f, Text = "", AutoButtonColor = false, ZIndex = 6, AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-14,0.5,0), Size = UDim2.fromOffset(52,26), ClipsDescendants = true, BackgroundColor3 = state and Theme.Yang or Theme.Off, BackgroundTransparency = state and 0.05 or 0.35}, { circle() })
			local tScale  = new("UIScale", {Parent = track, Scale = 1})
			local tStroke = stroke(Color3.new(1,1,1), 1.4, 0.4); tStroke.Parent = track

			local grad = new("UIGradient", {Parent = track, Rotation = 0, Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,255,255)), ColorSequenceKeypoint.new(0.35, Theme.Aqua), ColorSequenceKeypoint.new(0.65, Theme.Violet), ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,255,255))}, Transparency = NumberSequence.new(state and 0 or 1)})
			local knob = new("Frame", {Parent = track, ZIndex = 8, Size = UDim2.fromOffset(KNOB,KNOB), AnchorPoint = Vector2.new(0,0.5), Position = state and ON_L or OFF_L, BackgroundColor3 = Theme.Yang, BorderSizePixel = 0}, { circle() })
			local knobDot = new("Frame", {Parent = knob, ZIndex = 9, Size = UDim2.fromOffset(7,7), AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.fromScale(0.5,0.5), BackgroundColor3 = state and Theme.Aqua or Theme.Off, BorderSizePixel = 0}, { circle() })

			local busy = false
			track.MouseButton1Click:Connect(function()
				if busy then return end
				busy = true; state = not state
				tw(track, SMOOTH, {BackgroundColor3 = state and Theme.Yang or Theme.Off, BackgroundTransparency = state and 0.05 or 0.35})
				tw(knob, SPRING, {Position = state and ON_L or OFF_L})
				tw(knobDot, SMOOTH, {BackgroundColor3 = state and Theme.Aqua or Theme.Off})
				fadeGrad(grad, state and 1 or 0, state and 0 or 1, 0.3)
				click(state and 1.15 or 0.85)
				if cb then task.spawn(cb, state) end
				task.delay(0.18, function() busy = false end)
			end)
		end

		function TabAPI:AddSlider(text, min, max, default, cb)
			local f = card(page, 60); label(f, text)
			local value = math.clamp(default, min, max)
			local vBox = new("TextLabel", {Parent = f, ZIndex = 6, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-14,0,0), Size = UDim2.fromOffset(58,42), Text = tostring(value), Font = Enum.Font.GothamBold, TextSize = 12.5, TextColor3 = Theme.Sub, TextXAlignment = Enum.TextXAlignment.Right})
			local bar = new("Frame", {Parent = f, ZIndex = 6, Position = UDim2.new(0,14,0,40), Size = UDim2.new(1,-28,0,7), BackgroundColor3 = Theme.Off, BackgroundTransparency = 0.35, BorderSizePixel = 0, ClipsDescendants = true}, { circle() })
			local fill = new("Frame", {Parent = bar, ZIndex = 6, BorderSizePixel = 0, Size = UDim2.fromScale((value-min)/(max-min),1), BackgroundColor3 = Theme.Aqua}, { circle() })
			local knob = new("Frame", {Parent = bar, Size = UDim2.fromOffset(15,15), ZIndex = 9, AnchorPoint = Vector2.new(0.5,0.5), BorderSizePixel = 0, Position = UDim2.fromScale((value-min)/(max-min),0.5), BackgroundColor3 = Theme.Yang}, { circle() })
			local hit = new("TextButton", {Parent = bar, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1,0,0,30), Position = UDim2.new(0,0,0.5,0), AnchorPoint = Vector2.new(0,0.5), ZIndex = 10, AutoButtonColor = false})

			local dragging = false
			local function set(px)
				local a = math.clamp((px - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X,1), 0, 1)
				value = math.floor(min + (max-min)*a + 0.5)
				tw(fill, TweenInfo.new(0.1), {Size = UDim2.fromScale(a,1)})
				tw(knob, TweenInfo.new(0.1), {Position = UDim2.fromScale(a,0.5)})
				vBox.Text = tostring(value)
				if cb then task.spawn(cb, value) end
			end

			hit.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					dragging = true; set(i.Position.X)
					i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging = false end end)
				end
			end)
			UserInputService.InputChanged:Connect(function(i)
				if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then set(i.Position.X) end
			end)
		end

		function TabAPI:AddDropdown(text, options, cb)
			local ROW = 46
			local f = card(page, ROW); label(f, text)
			local open = false
			local selected = new("TextLabel", {Parent = f, ZIndex = 6, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-34,0,0), Size = UDim2.fromOffset(112, ROW), Text = options[1] or "-", Font = Enum.Font.GothamMedium, TextSize = 11.5, TextColor3 = Theme.Sub, TextXAlignment = Enum.TextXAlignment.Right})
			local arrow = new("TextLabel", {Parent = f, ZIndex = 6, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-14,0,0), Size = UDim2.fromOffset(16, ROW), Text = "▾", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.Text})
			local list = new("Frame", {Parent = f, ZIndex = 6, Position = UDim2.new(0,10,0,ROW), Size = UDim2.new(1,-20,0,0), BackgroundTransparency = 1, ClipsDescendants = true}, { new("UIListLayout", {Padding = UDim.new(0,5)}) })
			local head = new("TextButton", {Parent = f, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1,0,0,ROW), ZIndex = 7, AutoButtonColor = false})

			head.MouseButton1Click:Connect(function()
				open = not open
				tw(f, open and SPRING or QUINT, {Size = UDim2.new(1,-6,0, open and (ROW + #options*33 + 10) or ROW)})
				tw(arrow, SPRING, {Rotation = open and 180 or 0})
				tw(list, SMOOTH, {Size = UDim2.new(1,-20,0, open and (#options*33) or 0)})
				click(open and 1.1 or 0.9)
			end)

			for idx, opt in ipairs(options) do
				local b = new("TextButton", {Parent = list, ZIndex = 6, Size = UDim2.new(1,0,0,28), Text = opt, LayoutOrder = idx, Font = Enum.Font.Gotham, TextSize = 11.5, TextColor3 = Theme.Sub, BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.5, AutoButtonColor = false}, { corner(8) })
				b.MouseButton1Click:Connect(function()
					selected.Text = opt
					if cb then task.spawn(cb, opt) end
					open = false
					tw(f, QUINT, {Size = UDim2.new(1,-6,0, ROW)})
					tw(arrow, SPRING, {Rotation = 0})
					tw(list, SMOOTH, {Size = UDim2.new(1,-20,0, 0)})
				end)
			end
		end

		function TabAPI:AddTextBox(text, placeholder, cb)
			local f = card(page, 46); label(f, text)
			local box = new("TextBox", {Parent = f, ZIndex = 6, AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-14,0.5,0), Size = UDim2.fromOffset(134,29), BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.35, Text = "", PlaceholderText = placeholder, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 11.5, ClearTextOnFocus = false}, { corner(9) })
			box.FocusLost:Connect(function(enter)
				if enter and cb then task.spawn(cb, box.Text) end
			end)
		end

		return TabAPI
	end

	-- Orb & Visibility Toggle
	local orb = new("TextButton", {Parent = gui, Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(48,48), AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.new(0.5,-262,0.5,0), ZIndex = 20, ClipsDescendants = true}, { circle() })
	applyGlass(orb, 0.3, Theme.Panel)
	makeYinYang(orb, 32, UDim2.fromScale(0.5,0.5), true, 24)
	makeDraggable(orb, orb)

	local targetScale = 1
	local shown = false
	local function setShown(v)
		shown = v
		if v then
			window.Visible = true
			uiScale.Scale = 0
			tw(uiScale, SPRING, {Scale = targetScale})
			if blur then tw(blur, TweenInfo.new(0.5), {Size = 18}) end
		else
			local t = tw(uiScale, TweenInfo.new(0.25), {Scale = 0})
			if t then t.Completed:Once(function() window.Visible = false end) end
			if blur then tw(blur, TweenInfo.new(0.4), {Size = 0}) end
		end
		click(v and 1.2 or 0.8)
	end

	orb.MouseButton1Click:Connect(function() setShown(not shown) end)
	closeBtn.MouseButton1Click:Connect(function() setShown(false) end)

	UserInputService.InputBegan:Connect(function(i, gp)
		if not gp and i.KeyCode == Enum.KeyCode.RightShift then setShown(not shown) end
	end)

	task.defer(function() setShown(true) end)

	return WindowAPI
end

return Library
