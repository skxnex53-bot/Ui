	local head = new("TextButton", {Parent = f, Text = "", BackgroundTransparency = 1,
		Size = UDim2.new(1,0,0,ROW), ZIndex = 7, AutoButtonColor = false})

	local items = {}
	local function toggle()
		open = not open
		local h = open and (ROW + #options * 33 + 10) or ROW
		tw(f, open and TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			or QUINT, {Size = UDim2.new(1,-6,0,h)})
		tw(arrow, SPRING, {Rotation = open and 180 or 0,
			TextColor3 = open and Theme.Aqua or Theme.Text})
		tw(list, SMOOTH, {Size = UDim2.new(1,-20,0, open and (#options*33) or 0)})

		for i, b in ipairs(items) do
			if open then
				b.Position = UDim2.new(0, -20, 0, 0)
				b.BackgroundTransparency = 1
				b.TextTransparency = 1
				task.delay(i * 0.045, function()
					tw(b, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
						{Position = UDim2.new(0,0,0,0)})
					tw(b, SMOOTH, {BackgroundTransparency = 0.5, TextTransparency = 0})
				end)
			end
		end
		if open then sheen(f, 0.8, 12) end
		lib:Click(open and 1.1 or 0.9)
