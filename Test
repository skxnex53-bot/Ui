	task.delay(0.08, function() self:Click(1.75) end)
	task.delay(0.16, function() self:Click(2.15) end)

	local primaryColor = accentColor or Theme.Aqua
	local secondaryColor = (primaryColor == Theme.Aqua) and Theme.Violet or Theme.Rose

	self:Shockwave(centerPos, primaryColor, 260, 4)
	task.delay(0.06, function() self:Shockwave(centerPos, secondaryColor, 340, 3) end)
