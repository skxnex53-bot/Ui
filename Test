function Library:SetupOrb()
	local orb = new("TextButton", {Parent = self.Gui, Text = "", AutoButtonColor = false,
		Size = UDim2.fromOffset(48,48), AnchorPoint = Vector2.new(0.5,0.5),
		Position = UDim2.new(0.5,-262,0.5,0), ZIndex = 20,
		ClipsDescendants = true}, { circle() })
	local orbStroke = applyGlass(orb, 0.3, Theme.Panel)
	makeYinYang(orb, 32, UDim2.fromScale(0.5,0.5), true, 24)
	local orbScale = new("UIScale", {Parent = orb, Scale = 1})
	makeDraggable(orb, orb)

	orb.MouseEnter:Connect(function()
		tw(orbScale, SPRING, {Scale = 1.14})
		tw(orbStroke, SMOOTH, {Transparency = 0.05, Thickness = 2.2})
		sheen(orb, 0.6, 26)
	end)
	orb.MouseLeave:Connect(function()
		tw(orbScale, SPRING, {Scale = 1})
		tw(orbStroke, SMOOTH, {Transparency = 0.45, Thickness = 1.3})
	end)

	self.Shown = false
	local function setShown(v)
		self.Shown = v
		if v then
			self.Window.Visible = true
			self.UiScale.Scale = 0
			self.Window.Rotation = -6
			tw(self.UiScale, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{Scale = self.TargetScale})
			tw(self.Window, TweenInfo.new(0.7, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
				{Rotation = 0})
			task.delay(0.15, function() sheen(self.Window, 1.0, 70) end)
			if self.Blur then tw(self.Blur, TweenInfo.new(0.5), {Size = 18}) end
		else
			local t = tw(self.UiScale, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.In),
				{Scale = 0})
			tw(self.Window, TweenInfo.new(0.32), {Rotation = 5})
			if t then t.Completed:Once(function() self.Window.Visible = false end)
			else self.Window.Visible = false end
			if self.Blur then tw(self.Blur, TweenInfo.new(0.4), {Size = 0}) end
		end
		self:Click(v and 1.2 or 0.8)
	end

	orb.MouseButton1Click:Connect(function() setShown(not self.Shown) end)
	self.CloseBtn.MouseButton1Click:Connect(function() setShown(false) end)

	self.CloseBtn.MouseEnter:Connect(function()
		tw(self.CloseBtn, SMOOTH, {BackgroundColor3 = Color3.fromRGB(220,70,90),
			BackgroundTransparency = 0.1, TextColor3 = Theme.Yang}) end)
	self.CloseBtn.MouseLeave:Connect(function()
		tw(self.CloseBtn, SMOOTH, {BackgroundColor3 = Theme.Card,
			BackgroundTransparency = 0.35, TextColor3 = Theme.Sub}) end)

	UserInputService.InputBegan:Connect(function(i, gp)
		if not gp and i.KeyCode == Enum.KeyCode.RightShift then setShown(not self.Shown) end
	end)

	self.SetShown = setShown
end

function Library:PlayPageEpicTransition(pageName, accentColor)
